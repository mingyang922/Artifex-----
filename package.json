{
    "name": "artifex-platform",
    "version": "1.4.0",
    "description": "Artifex 二维游戏美术协作与AI资产生成平台",
    "main": "backend/proxy.js",
    "scripts": {
        "preinstall": "node scripts/check-node-version.js",
        "postinstall": "node scripts/postinstall-native.js",
        "check:node": "node scripts/check-node-version.js",
        "start": "node backend/proxy.js",
        "start:open": "concurrently -n backend,ready \"cross-env NODE_ENV=development npm start\" \"wait-on http://127.0.0.1:3000/api/health -t 120000 && node scripts/open-browser.js\"",
        "dev": "concurrently -n backend,vite \"nodemon backend/proxy.js\" \"vite\"",
        "build": "vite build && node scripts/prepare-dist.js && node scripts/generate-sw-manifest.js",
        "build:with-sw": "npm run build",
        "preview": "vite preview",
        "lint": "eslint --no-error-on-unmatched-pattern backend js modules scripts *.js",
        "lint:fix": "npm run lint -- --fix",
        "format": "prettier --write \"backend/**/*.{js,json}\" \"js/**/*.{js,json}\" \"modules/**/*.{js,css,html,json}\" \"scripts/**/*.{js,json}\" \"*.{html,css,js,json,md}\"",
        "format:check": "prettier --check \"backend/**/*.{js,json}\" \"js/**/*.{js,json}\" \"modules/**/*.{js,css,html,json}\" \"scripts/**/*.{js,json}\" \"*.{html,css,js,json,md}\"",
        "check:architecture": "node scripts/check-frontend-boundaries.js",
        "check:docs": "node scripts/check-doc-consistency.js",
        "install-deps": "npm install express axios dotenv",
        "setup": "npm run install-deps && echo \"请在 config/.env 中配置 API 密钥等变量（见 README）\"",
        "test": "node --test tests/backend.test.js tests/routes.test.js tests/utils.test.js tests/workspace.test.js tests/production-insights.test.js tests/session-store.test.js",
        "test:e2e": "npx playwright test",
        "test:e2e:production": "npx playwright test --config=playwright.production.config.js",
        "ci": "npm run lint && npm run check:architecture && npm run check:docs && npm test",
        "deploy:production": "powershell -ExecutionPolicy Bypass -File deploy/production-deploy.ps1",
        "precommit": "npm run lint"
    },
    "dependencies": {
        "axios": "^1.19.0",
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^12.10.0",
        "compression": "^1.8.1",
        "dotenv": "^17.4.2",
        "esbuild": "^0.28.1",
        "express": "^4.18.2",
        "express-rate-limit": "^8.5.2",
        "express-session": "^1.19.0",
        "form-data": "^4.0.5",
        "helmet": "^8.2.0",
        "tencentcloud-sdk-nodejs": "^4.0.821",
        "ws": "^8.21.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.60.0",
        "concurrently": "^9.1.2",
        "cross-env": "^7.0.3",
        "eslint": "^9.38.0",
        "globals": "^16.4.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.8.4",
        "supertest": "^7.2.2",
        "vite": "^8.0.16",
        "wait-on": "^8.0.1"
    },
    "overrides": {
        "body-parser": "^1.20.6",
        "minimatch@3.1.5": {
            "brace-expansion": "1.1.18"
        },
        "minimatch@10.2.5": {
            "brace-expansion": "5.0.8"
        },
        "postcss": "^8.5.18"
    },
    "keywords": [
        "artifex",
        "ai",
        "game-art",
        "asset-pipeline",
        "ui-tools"
    ],
    "author": "窦英杰, 黄建文, 吴名扬",
    "license": "MIT",
    "engines": {
        "node": ">=22.14.0"
    },
    "volta": {
        "node": "22.22.0"
    }
}
