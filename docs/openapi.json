{
    "openapi": "3.0.3",
    "info": {
        "title": "Artifex API",
        "description": "二维游戏美术协作与 AI 资产生成平台 API",
        "version": "1.0.0",
        "contact": { "name": "Artifex Team" }
    },
    "servers": [
        { "url": "http://127.0.0.1:3000", "description": "本地开发" }
    ],
    "tags": [
        { "name": "auth", "description": "认证与用户管理" },
        { "name": "config", "description": "运行时配置" },
        { "name": "image", "description": "图片生成" },
        { "name": "chat", "description": "AI 对话" },
        { "name": "status", "description": "服务状态" },
        { "name": "projects", "description": "项目管理" },
        { "name": "asset-library", "description": "素材库" },
        { "name": "admin", "description": "管理员功能" },
        { "name": "usage", "description": "用量统计" }
    ],
    "paths": {
        "/api/health": {
            "get": {
                "tags": ["status"],
                "summary": "健康检查",
                "responses": { "200": { "description": "服务正常" } }
            }
        },
        "/api/csrf-token": {
            "get": {
                "tags": ["auth"],
                "summary": "获取 CSRF 令牌",
                "responses": { "200": { "description": "返回 csrfToken" } }
            }
        },
        "/api/auth/register": {
            "post": {
                "tags": ["auth"],
                "summary": "注册",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["username", "email", "password"],
                                "properties": {
                                    "username": { "type": "string" },
                                    "email": { "type": "string", "format": "email" },
                                    "password": { "type": "string", "minLength": 6 }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "注册成功" },
                    "400": { "description": "参数错误" },
                    "409": { "description": "邮箱/用户名已存在" }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": ["auth"],
                "summary": "登录",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["email", "password"],
                                "properties": {
                                    "email": { "type": "string" },
                                    "password": { "type": "string" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "登录成功" },
                    "401": { "description": "邮箱或密码错误" }
                }
            }
        },
        "/api/auth/logout": {
            "post": { "tags": ["auth"], "summary": "登出", "responses": { "200": { "description": "已登出" } } }
        },
        "/api/me": {
            "get": { "tags": ["auth"], "summary": "获取当前用户信息", "responses": { "200": { "description": "用户信息" } } }
        },
        "/api/me/profile": {
            "put": {
                "tags": ["auth"],
                "summary": "更新用户资料",
                "requestBody": {
                    "content": { "application/json": { "schema": { "type": "object", "properties": { "profile": { "type": "object" } } } } }
                },
                "responses": { "200": { "description": "更新成功" } }
            }
        },
        "/api/me/api-settings": {
            "get": { "tags": ["auth"], "summary": "获取 API 设置（脱敏）", "responses": { "200": { "description": "API 设置" } } },
            "put": {
                "tags": ["auth"],
                "summary": "更新 API 设置",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "provider": { "type": "string", "enum": ["tencent", "alibaba", "jimeng", "sdwebui"] },
                                    "credentials": { "type": "object" }
                                }
                            }
                        }
                    }
                },
                "responses": { "200": { "description": "设置成功" } }
            }
        },
        "/api/me/api-settings/{provider}": {
            "delete": {
                "tags": ["auth"],
                "summary": "删除 API 设置",
                "parameters": [{ "name": "provider", "in": "path", "required": true, "schema": { "type": "string" } }],
                "responses": { "200": { "description": "删除成功" } }
            }
        },
        "/api/image-proxy": {
            "post": {
                "tags": ["image"],
                "summary": "图片生成（文生图 / 图生图）",
                "description": "支持 tencent / alibaba / jimeng / sdwebui / free / mock 等 provider",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["prompt"],
                                "properties": {
                                    "prompt": { "type": "string", "description": "生成提示词" },
                                    "size": { "type": "string", "description": "尺寸，如 1024x1024" },
                                    "provider": { "type": "string", "enum": ["tencent", "alibaba", "jimeng", "sdwebui", "free", "mock"], "default": "tencent" },
                                    "mode": { "type": "string", "enum": ["text2img", "img2img"], "default": "text2img" },
                                    "image": { "type": "string", "description": "图生图的 base64 / data URL" },
                                    "strength": { "type": "number", "default": 0.7 },
                                    "imageModel": { "type": "string" },
                                    "styleReferenceImage": { "type": "string" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "生成成功，返回 image_url" },
                    "400": { "description": "参数错误" },
                    "502": { "description": "上游 API 失败" }
                }
            }
        },
        "/api/proxy-image": {
            "get": {
                "tags": ["image"],
                "summary": "代理拉取远程图片",
                "parameters": [{ "name": "url", "in": "query", "required": true, "schema": { "type": "string" } }],
                "responses": { "200": { "description": "图片内容" } }
            }
        },
        "/api/hunyuan-proxy": {
            "post": {
                "tags": ["chat"],
                "summary": "腾讯混元对话代理",
                "responses": { "200": { "description": "对话结果" } }
            }
        },
        "/api/alibaba-proxy": {
            "post": {
                "tags": ["chat"],
                "summary": "阿里通义千问对话代理",
                "responses": { "200": { "description": "对话结果" } }
            }
        },
        "/api/alibaba-vision-proxy": {
            "post": {
                "tags": ["chat"],
                "summary": "阿里多模态视觉代理",
                "responses": { "200": { "description": "分析结果" } }
            }
        },
        "/api/config": {
            "get": { "tags": ["config"], "summary": "获取运行时配置状态", "responses": { "200": { "description": "配置状态" } } }
        },
        "/api/tencent/status": {
            "get": { "tags": ["status"], "summary": "腾讯云密钥自检", "responses": { "200": { "description": "状态信息" } } }
        },
        "/api/sd-webui/status": {
            "get": { "tags": ["status"], "summary": "SD Web UI 连通性", "responses": { "200": { "description": "状态信息" } } }
        },
        "/api/jimeng/status": {
            "get": { "tags": ["status"], "summary": "即梦连通性", "responses": { "200": { "description": "状态信息" } } }
        },
        "/api/projects": {
            "get": {
                "tags": ["projects"],
                "summary": "获取用户所有项目",
                "parameters": [
                    { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1, "minimum": 1 }, "description": "页码" },
                    { "name": "pageSize", "in": "query", "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 }, "description": "每页条数" }
                ],
                "responses": { "200": { "description": "项目列表" } }
            },
            "post": {
                "tags": ["projects"],
                "summary": "创建项目",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["name"],
                                "properties": {
                                    "name": { "type": "string", "description": "项目名称" },
                                    "description": { "type": "string", "description": "项目描述" },
                                    "type": { "type": "string", "description": "项目类型" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "创建成功" },
                    "400": { "description": "项目名称不能为空" }
                }
            }
        },
        "/api/projects/{id}": {
            "put": {
                "tags": ["projects"],
                "summary": "更新项目",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": { "type": "string" },
                                    "description": { "type": "string" },
                                    "type": { "type": "string" },
                                    "versionDesc": { "type": "string" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "更新成功" },
                    "404": { "description": "项目不存在" }
                }
            },
            "delete": {
                "tags": ["projects"],
                "summary": "删除项目",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": { "200": { "description": "删除成功" } }
            }
        },
        "/api/projects/{id}/assets": {
            "post": {
                "tags": ["projects"],
                "summary": "添加项目素材",
                "description": "向项目添加素材。内容大小限制为 10MB。仅接受 PNG、JPG/JPEG、GIF、WebP、SVG 格式的图片。",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["name", "content"],
                                "properties": {
                                    "name": { "type": "string", "description": "素材名称" },
                                    "type": { "type": "string", "description": "素材类型（如 image/png, image/jpeg）" },
                                    "content": { "type": "string", "description": "素材内容（base64 或 data URL），最大 10MB" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "添加成功" },
                    "400": { "description": "素材名称和内容不能为空" },
                    "413": { "description": "素材内容过大，最大允许 10MB" }
                }
            }
        },
        "/api/assets/{id}": {
            "delete": {
                "tags": ["projects"],
                "summary": "删除项目素材",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": { "200": { "description": "删除成功" } }
            }
        },
        "/api/asset-library": {
            "get": {
                "tags": ["asset-library"],
                "summary": "获取用户素材库",
                "parameters": [
                    { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1, "minimum": 1 }, "description": "页码" },
                    { "name": "pageSize", "in": "query", "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 }, "description": "每页条数" }
                ],
                "responses": { "200": { "description": "素材列表" } }
            },
            "post": {
                "tags": ["asset-library"],
                "summary": "添加素材到素材库",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["name", "content"],
                                "properties": {
                                    "name": { "type": "string", "description": "素材名称" },
                                    "type": { "type": "string", "description": "素材类型" },
                                    "content": { "type": "string", "description": "素材内容（base64 或 data URL），最大 10MB" },
                                    "desc": { "type": "string", "description": "素材描述" },
                                    "source": { "type": "string", "description": "素材来源" },
                                    "tags": { "type": "string", "description": "标签（逗号分隔）" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "添加成功" },
                    "400": { "description": "素材名称和内容不能为空" },
                    "413": { "description": "素材内容过大，最大允许 10MB" }
                }
            }
        },
        "/api/asset-library/{id}": {
            "put": {
                "tags": ["asset-library"],
                "summary": "更新素材库素材",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": { "type": "string" },
                                    "desc": { "type": "string" },
                                    "tags": { "type": "string" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "更新成功" },
                    "404": { "description": "素材不存在" }
                }
            },
            "delete": {
                "tags": ["asset-library"],
                "summary": "删除素材库素材",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": { "200": { "description": "删除成功" } }
            }
        },
        "/api/me/usage": {
            "get": {
                "tags": ["usage"],
                "summary": "获取当前用户用量统计",
                "responses": { "200": { "description": "用量统计（stats + today）" } }
            }
        },
        "/api/admin/usage": {
            "get": {
                "tags": ["admin"],
                "summary": "管理员：全局用量统计",
                "responses": {
                    "200": { "description": "全局用量汇总与明细" },
                    "403": { "description": "权限不足" }
                }
            }
        },
        "/api/admin/users": {
            "get": {
                "tags": ["admin"],
                "summary": "管理员：用户列表",
                "responses": {
                    "200": { "description": "用户列表" },
                    "403": { "description": "权限不足" }
                }
            }
        },
        "/api/health/detail": {
            "get": {
                "tags": ["admin"],
                "summary": "详细健康检查（管理员）",
                "responses": {
                    "200": { "description": "详细配置状态" },
                    "403": { "description": "权限不足" }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "connect.sid"
            }
        }
    },
    "security": [{ "cookieAuth": [] }]
}
