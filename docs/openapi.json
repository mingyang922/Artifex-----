{
    "openapi": "3.0.3",
    "info": {
        "title": "Artifex API",
        "description": "二维游戏美术协作与 AI 资产生成平台 API",
        "version": "1.4.0",
        "contact": { "name": "Artifex Team" }
    },
    "servers": [
        { "url": "http://127.0.0.1:3000", "description": "本地开发" }
    ],
    "tags": [
        { "name": "auth", "description": "认证与用户管理" },
        { "name": "config", "description": "运行时配置" },
        { "name": "image", "description": "图片生成" },
        { "name": "chat", "description": "AI 对话" },
        { "name": "status", "description": "服务状态" },
        { "name": "projects", "description": "项目管理" },
        { "name": "asset-library", "description": "素材库" },
        { "name": "admin", "description": "管理员功能" },
        { "name": "usage", "description": "用量统计" }
        ,{ "name": "workflow", "description": "生成历史、角色档案、LoRA 与通知" }
        ,{ "name": "collaboration", "description": "项目成员、审核、版本和分享" }
    ],
    "paths": {
        "/api/health": {
            "get": {
                "tags": ["status"],
                "summary": "健康检查",
                "responses": { "200": { "description": "服务正常" } }
            }
        },
        "/api/csrf-token": {
            "get": {
                "tags": ["auth"],
                "summary": "获取 CSRF 令牌",
                "responses": { "200": { "description": "返回 csrfToken" } }
            }
        },
        "/api/auth/register": {
            "post": {
                "tags": ["auth"],
                "summary": "注册",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["username", "email", "password"],
                                "properties": {
                                    "username": { "type": "string" },
                                    "email": { "type": "string", "format": "email" },
                                    "password": { "type": "string", "minLength": 6 }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "注册成功" },
                    "400": { "description": "参数错误" },
                    "409": { "description": "邮箱/用户名已存在" }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": ["auth"],
                "summary": "登录",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["email", "password"],
                                "properties": {
                                    "email": { "type": "string" },
                                    "password": { "type": "string" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "登录成功" },
                    "401": { "description": "邮箱或密码错误" }
                }
            }
        },
        "/api/auth/logout": {
            "post": { "tags": ["auth"], "summary": "登出", "responses": { "200": { "description": "已登出" } } }
        },
        "/api/me": {
            "get": { "tags": ["auth"], "summary": "获取当前用户信息", "responses": { "200": { "description": "用户信息" } } }
        },
        "/api/me/profile": {
            "put": {
                "tags": ["auth"],
                "summary": "更新用户资料",
                "requestBody": {
                    "content": { "application/json": { "schema": { "type": "object", "properties": { "profile": { "type": "object" } } } } }
                },
                "responses": { "200": { "description": "更新成功" } }
            }
        },
        "/api/me/change-password": {
            "post": {
                "tags": ["auth"],
                "summary": "修改密码（限流：5次/15分钟）",
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": { "type": "object", "required": ["currentPassword", "newPassword"], "properties": { "currentPassword": { "type": "string" }, "newPassword": { "type": "string", "minLength": 6 } } } } }
                },
                "responses": { "200": { "description": "密码修改成功" }, "401": { "description": "当前密码不正确" } }
            }
        },
        "/api/me/api-settings/validate": {
            "post": {
                "tags": ["auth"],
                "summary": "验证 API 密钥有效性",
                "requestBody": {
                    "required": true,
                    "content": { "application/json": { "schema": { "type": "object", "required": ["provider", "credentials"], "properties": { "provider": { "type": "string" }, "credentials": { "type": "object" } } } } }
                },
                "responses": { "200": { "description": "验证结果" } }
            }
        },
        "/api/me/api-settings": {
            "get": { "tags": ["auth"], "summary": "获取 API 设置（脱敏）", "responses": { "200": { "description": "API 设置" } } },
            "put": {
                "tags": ["auth"],
                "summary": "更新 API 设置",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "provider": { "type": "string", "enum": ["tencent", "alibaba", "jimeng", "sdwebui"] },
                                    "credentials": { "type": "object" }
                                }
                            }
                        }
                    }
                },
                "responses": { "200": { "description": "设置成功" } }
            }
        },
        "/api/me/api-settings/{provider}": {
            "delete": {
                "tags": ["auth"],
                "summary": "删除 API 设置",
                "parameters": [{ "name": "provider", "in": "path", "required": true, "schema": { "type": "string" } }],
                "responses": { "200": { "description": "删除成功" } }
            }
        },
        "/api/image-proxy": {
            "post": {
                "tags": ["image"],
                "summary": "图片生成（文生图 / 图生图）",
                "description": "支持 tencent / alibaba / jimeng / sdwebui / free / mock 等 provider",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["prompt"],
                                "properties": {
                                    "prompt": { "type": "string", "description": "生成提示词" },
                                    "size": { "type": "string", "description": "尺寸，如 1024x1024" },
                                    "provider": { "type": "string", "enum": ["tencent", "alibaba", "jimeng", "sdwebui", "free", "mock"], "default": "tencent" },
                                    "mode": { "type": "string", "enum": ["text2img", "img2img"], "default": "text2img" },
                                    "image": { "type": "string", "description": "图生图的 base64 / data URL" },
                                    "strength": { "type": "number", "default": 0.7 },
                                    "imageModel": { "type": "string" },
                                    "styleReferenceImage": { "type": "string" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "生成成功，返回 image_url" },
                    "400": { "description": "参数错误" },
                    "502": { "description": "上游 API 失败" }
                }
            }
        },
        "/api/proxy-image": {
            "get": {
                "tags": ["image"],
                "summary": "代理拉取远程图片",
                "parameters": [{ "name": "url", "in": "query", "required": true, "schema": { "type": "string" } }],
                "responses": { "200": { "description": "图片内容" } }
            }
        },
        "/api/hunyuan-proxy": {
            "post": {
                "tags": ["chat"],
                "summary": "腾讯混元对话代理",
                "responses": { "200": { "description": "对话结果" } }
            }
        },
        "/api/alibaba-proxy": {
            "post": {
                "tags": ["chat"],
                "summary": "阿里通义千问对话代理",
                "responses": { "200": { "description": "对话结果" } }
            }
        },
        "/api/alibaba-vision-proxy": {
            "post": {
                "tags": ["chat"],
                "summary": "阿里多模态视觉代理",
                "responses": { "200": { "description": "分析结果" } }
            }
        },
        "/api/config": {
            "get": { "tags": ["config"], "summary": "获取运行时配置状态", "responses": { "200": { "description": "配置状态" } } }
        },
        "/api/tencent/status": {
            "get": { "tags": ["status"], "summary": "腾讯云密钥自检", "responses": { "200": { "description": "状态信息" } } }
        },
        "/api/sd-webui/status": {
            "get": { "tags": ["status"], "summary": "SD Web UI 连通性", "responses": { "200": { "description": "状态信息" } } }
        },
        "/api/jimeng/status": {
            "get": { "tags": ["status"], "summary": "即梦连通性", "responses": { "200": { "description": "状态信息" } } }
        },
        "/api/jimeng/live-test": {
            "post": { "tags": ["status"], "summary": "即梦在线测试（消耗 API 配额）", "responses": { "200": { "description": "测试结果" } } }
        },
        "/api/projects": {
            "get": {
                "tags": ["projects"],
                "summary": "获取用户所有项目",
                "parameters": [
                    { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1, "minimum": 1 }, "description": "页码" },
                    { "name": "pageSize", "in": "query", "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 }, "description": "每页条数" }
                ],
                "responses": { "200": { "description": "项目列表" } }
            },
            "post": {
                "tags": ["projects"],
                "summary": "创建项目",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["name"],
                                "properties": {
                                    "name": { "type": "string", "description": "项目名称" },
                                    "description": { "type": "string", "description": "项目描述" },
                                    "type": { "type": "string", "description": "项目类型" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "创建成功" },
                    "400": { "description": "项目名称不能为空" }
                }
            }
        },
        "/api/projects/{id}": {
            "put": {
                "tags": ["projects"],
                "summary": "更新项目",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": { "type": "string" },
                                    "description": { "type": "string" },
                                    "type": { "type": "string" },
                                    "versionDesc": { "type": "string" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "更新成功" },
                    "404": { "description": "项目不存在" }
                }
            },
            "delete": {
                "tags": ["projects"],
                "summary": "删除项目",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": { "200": { "description": "删除成功" } }
            }
        },
        "/api/projects/{id}/assets": {
            "post": {
                "tags": ["projects"],
                "summary": "添加项目素材",
                "description": "向项目添加素材。内容大小限制为 10MB。仅接受 PNG、JPG/JPEG、GIF、WebP、SVG 格式的图片。",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["name", "content"],
                                "properties": {
                                    "name": { "type": "string", "description": "素材名称" },
                                    "type": { "type": "string", "description": "素材类型（如 image/png, image/jpeg）" },
                                    "content": { "type": "string", "description": "素材内容（base64 或 data URL），最大 10MB" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "添加成功" },
                    "400": { "description": "素材名称和内容不能为空" },
                    "413": { "description": "素材内容过大，最大允许 10MB" }
                }
            }
        },
        "/api/assets/{id}": {
            "delete": {
                "tags": ["projects"],
                "summary": "删除项目素材",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": { "200": { "description": "删除成功" } }
            }
        },
        "/api/asset-library": {
            "get": {
                "tags": ["asset-library"],
                "summary": "获取用户素材库",
                "parameters": [
                    { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1, "minimum": 1 }, "description": "页码" },
                    { "name": "pageSize", "in": "query", "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 }, "description": "每页条数" }
                ],
                "responses": { "200": { "description": "素材列表" } }
            },
            "post": {
                "tags": ["asset-library"],
                "summary": "添加素材到素材库",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["name", "content"],
                                "properties": {
                                    "name": { "type": "string", "description": "素材名称" },
                                    "type": { "type": "string", "description": "素材类型" },
                                    "content": { "type": "string", "description": "素材内容（base64 或 data URL），最大 10MB" },
                                    "desc": { "type": "string", "description": "素材描述" },
                                    "source": { "type": "string", "description": "素材来源" },
                                    "tags": { "type": "string", "description": "标签（逗号分隔）" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "添加成功" },
                    "400": { "description": "素材名称和内容不能为空" },
                    "413": { "description": "素材内容过大，最大允许 10MB" }
                }
            }
        },
        "/api/asset-library/{id}": {
            "put": {
                "tags": ["asset-library"],
                "summary": "更新素材库素材",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": { "type": "string" },
                                    "desc": { "type": "string" },
                                    "tags": { "type": "string" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "更新成功" },
                    "404": { "description": "素材不存在" }
                }
            },
            "delete": {
                "tags": ["asset-library"],
                "summary": "删除素材库素材",
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "responses": { "200": { "description": "删除成功" } }
            }
        },
        "/api/me/usage": {
            "get": {
                "tags": ["usage"],
                "summary": "获取当前用户用量统计",
                "responses": { "200": { "description": "用量统计（stats + today）" } }
            }
        },
        "/api/admin/usage": {
            "get": {
                "tags": ["admin"],
                "summary": "管理员：全局用量统计",
                "responses": {
                    "200": { "description": "全局用量汇总与明细" },
                    "403": { "description": "权限不足" }
                }
            }
        },
        "/api/admin/users": {
            "get": {
                "tags": ["admin"],
                "summary": "管理员：用户列表",
                "responses": {
                    "200": { "description": "用户列表" },
                    "403": { "description": "权限不足" }
                }
            }
        },
        "/api/admin/activity": {
            "get": {
                "tags": ["admin"],
                "summary": "管理员：查看全部活动日志",
                "parameters": [
                    { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } }
                ],
                "responses": {
                    "200": { "description": "活动日志" },
                    "403": { "description": "权限不足" }
                }
            }
        },
        "/api/generation-jobs": {
            "get": {
                "tags": ["workflow"],
                "summary": "获取当前用户的生成任务",
                "parameters": [
                    { "name": "status", "in": "query", "schema": { "type": "string" } },
                    { "name": "projectId", "in": "query", "schema": { "type": "integer" } },
                    { "name": "limit", "in": "query", "schema": { "type": "integer", "maximum": 100 } }
                ],
                "responses": { "200": { "description": "生成任务列表" } }
            },
            "post": {
                "tags": ["workflow"],
                "summary": "创建排队任务（状态和成本由服务端维护）",
                "responses": { "201": { "description": "已创建" }, "400": { "description": "参数无效" } }
            }
        },
        "/api/generation-jobs/{jobId}/retry": {
            "post": {
                "tags": ["workflow"],
                "summary": "将失败任务重新排队",
                "parameters": [{ "name": "jobId", "in": "path", "required": true, "schema": { "type": "integer" } }],
                "responses": { "200": { "description": "已重新排队" }, "404": { "description": "任务不存在" } }
            }
        },
        "/api/characters": {
            "get": { "tags": ["workflow"], "summary": "获取角色一致性档案", "responses": { "200": { "description": "角色列表" } } },
            "post": { "tags": ["workflow"], "summary": "创建角色档案", "responses": { "201": { "description": "已创建" } } }
        },
        "/api/lora-jobs": {
            "get": { "tags": ["workflow"], "summary": "获取 LoRA 训练任务", "responses": { "200": { "description": "LoRA 任务列表" } } },
            "post": { "tags": ["workflow"], "summary": "创建 LoRA 训练任务", "responses": { "201": { "description": "已排队" } } }
        },
        "/api/collaboration/projects": {
            "get": { "tags": ["collaboration"], "summary": "获取拥有或参与的项目", "responses": { "200": { "description": "协作项目列表" } } }
        },
        "/api/projects/{id}/members": {
            "get": { "tags": ["collaboration"], "summary": "获取项目成员", "responses": { "200": { "description": "成员列表" } } },
            "post": { "tags": ["collaboration"], "summary": "项目所有者添加成员", "responses": { "200": { "description": "已添加" }, "403": { "description": "权限不足" } } }
        },
        "/api/projects/{id}/comments": {
            "get": { "tags": ["collaboration"], "summary": "获取项目批注", "responses": { "200": { "description": "批注列表" } } },
            "post": { "tags": ["collaboration"], "summary": "发布项目批注", "responses": { "201": { "description": "已发布" } } }
        },
        "/api/projects/{id}/review": {
            "put": { "tags": ["collaboration"], "summary": "按角色权限更新审核状态", "responses": { "200": { "description": "已更新" }, "403": { "description": "角色无权设置该状态" } } }
        },
        "/api/projects/{id}/versions": {
            "get": { "tags": ["collaboration"], "summary": "获取项目版本快照", "responses": { "200": { "description": "版本列表" } } }
        },
        "/api/projects/{id}/versions/{version}/restore": {
            "post": { "tags": ["collaboration"], "summary": "事务性恢复项目与素材快照", "responses": { "200": { "description": "恢复成功" }, "403": { "description": "权限不足" } } }
        },
        "/api/projects/{id}/invites": {
            "get": { "tags": ["collaboration"], "summary": "项目所有者获取邀请", "responses": { "200": { "description": "邀请列表" } } },
            "post": { "tags": ["collaboration"], "summary": "创建成员邀请或只读分享", "responses": { "201": { "description": "已创建" } } }
        },
        "/api/shared-projects/{token}": {
            "get": {
                "security": [],
                "tags": ["collaboration"],
                "summary": "使用可撤销令牌获取只读项目",
                "responses": { "200": { "description": "只读项目" }, "404": { "description": "分享无效或过期" } }
            }
        },
        "/api/notifications": {
            "get": { "tags": ["workflow"], "summary": "获取当前用户通知", "responses": { "200": { "description": "通知列表" } } }
        },
        "/api/notifications/read-all": {
            "put": { "tags": ["workflow"], "summary": "全部标记已读", "responses": { "200": { "description": "已更新" } } }
        },
        "/api/asset-collections": {
            "get": { "tags": ["asset-library"], "summary": "获取素材集合", "responses": { "200": { "description": "集合列表" } } },
            "post": { "tags": ["asset-library"], "summary": "创建素材集合", "responses": { "201": { "description": "已创建" } } }
        },
        "/api/me/cost-summary": {
            "get": { "tags": ["usage"], "summary": "获取服务商任务与估算成本汇总", "responses": { "200": { "description": "成本与配额预警" } } }
        },
        "/api/health/detail": {
            "get": {
                "tags": ["admin"],
                "summary": "详细健康检查（管理员）",
                "responses": {
                    "200": { "description": "详细配置状态" },
                    "403": { "description": "权限不足" }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "connect.sid"
            }
        }
    },
    "security": [{ "cookieAuth": [] }]
}
