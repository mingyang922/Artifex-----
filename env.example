# Artifex 平台环境变量配置
# 复制此文件为 .env 并填写配置

# 服务端口（默认 3000）
PORT=3000

# 会话密钥（必填，生产环境请使用随机字符串）
# 生成命令：openssl rand -hex 32
SESSION_SECRET=

# API 凭证加密密钥（必填，必须与会话密钥不同且需长期稳定保存）
# 更换此值后，数据库中已有的用户 API 凭证将无法解密
ENCRYPTION_KEY=

# 允许的前端域名（必填，逗号分隔多个域名）
# 例如：https://artifex.example.com,https://your-domain.com
ALLOWED_ORIGINS=

# 管理员必须显式指定，未配置时首位注册用户仍为普通用户
ADMIN_USER_ID=
# 私有部署可设为 false 关闭公开注册
REGISTRATION_ENABLED=true

# ===========================================
# AI 服务配置（按需填写）
# ===========================================

# 腾讯混元（代码生成）
HUNYUAN_SECRET_ID=
HUNYUAN_SECRET_KEY=

# 阿里云通义千问（文本生成）
DASHSCOPE_API_KEY=

# 腾讯云图片服务
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 即梦 AI（图片生成）
JIMENG_API_KEY=

# SD WebUI（本地部署，可选）
# SD_WEBUI_URL=http://127.0.0.1:7860

# 密码重置邮件/消息网关（可选，接收 email、resetUrl、expiresAt）
PASSWORD_RESET_WEBHOOK_URL=

# LoRA 训练工作器（可选；启用后新任务会自动派发）
LORA_TRAINING_WEBHOOK_URL=
# Webhook 派发和回调共用的 Bearer Token，建议至少 32 位随机字符串
LORA_WORKER_TOKEN=
LORA_DISPATCH_TIMEOUT_MS=10000
