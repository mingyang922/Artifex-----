# Artifex 平台环境变量配置
# 复制此文件为 .env 并填写配置

# 服务端口（默认 3000）
PORT=3000

# 会话密钥（必填，生产环境请使用随机字符串）
# 生成命令：openssl rand -hex 32
SESSION_SECRET=your-random-session-secret-here

# 允许的前端域名（必填，逗号分隔多个域名）
# 例如：https://artifex.example.com,https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com

# ===========================================
# AI 服务配置（按需填写）
# ===========================================

# 腾讯混元（代码生成）
HUNYUAN_SECRET_ID=
HUNYUAN_SECRET_KEY=

# 阿里云通义千问（文本生成）
DASHSCOPE_API_KEY=

# 腾讯云图片服务
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 即梦 AI（图片生成）
JIMENG_API_KEY=

# SD WebUI（本地部署，可选）
# SD_WEBUI_URL=http://127.0.0.1:7860
