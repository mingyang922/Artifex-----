# 说明：
# 1) 本项目默认采用「用户登录后在用户中心自配 API」模式。
# 2) 下列服务商密钥仅作为平台运维级默认值（可不填）。

# 腾讯云（可选：管理员/运维默认）
# HUNYUAN_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HUNYUAN_SECRET_KEY=你的SecretKey_创建密钥时仅显示一次
# TENCENT_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TENCENT_SECRET_KEY=你的SecretKey_创建密钥时仅显示一次

# 阿里云（可选：管理员/运维默认）
# DASHSCOPE_API_KEY=sk-xxxxxxxx

# 即梦（可选：管理员/运维默认）
# JIMENG_API_KEY=sk-xxxxxxxx

# SD WebUI（可选：管理员/运维默认）
# SD_WEBUI_URL=http://127.0.0.1:7860
# SD_WEBUI_API_KEY=

# 服务器配置
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_SECRET=请改为足够长的随机字符串
