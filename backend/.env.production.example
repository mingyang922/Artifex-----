# 云服务器 production 示例（复制为 backend/.env，勿提交真实密钥）
# 路径示例：/srv/game-management/current/backend/.env

NODE_ENV=production
PORT=3000

# 必填：未设置会导致 node 启动后立即退出，Nginx 报 502，无法登录
SESSION_SECRET=请改为至少32位随机字符串

# 必填：须包含浏览器访问的完整来源（协议+主机，无末尾斜杠）
ALLOWED_ORIGINS=https://artifex.com.cn,https://www.artifex.com.cn,http://artifex.com.cn,http://www.artifex.com.cn

# 腾讯混元（CAM：SecretId 以 AKID 开头）
HUNYUAN_SECRET_ID=AKIDxxxxxxxx
HUNYUAN_SECRET_KEY=xxxxxxxx
TENCENT_SECRET_ID=AKIDxxxxxxxx
TENCENT_SECRET_KEY=xxxxxxxx

# 可选
DASHSCOPE_API_KEY=
JIMENG_API_KEY=
